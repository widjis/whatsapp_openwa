# Default approvers from whatsapp_api_n8nv2. Destination follows webhook receiver unless overridden.
# Comma-separated phone numbers, international format, no spaces needed.
SRF_APPROVER_PHONES=6282323336511,6285712612218,6289524548777,6281132041331

# Optional: blank/unset follows webhook receiver; set a group JID to override SRF PDFs only.
SRF_APPROVAL_GROUP_ID=
